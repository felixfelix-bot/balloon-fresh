(pcb output/v2_adc_freerouted.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "9.0.8+dfsg-1")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (boundary
      (path pcb 0  50000 -40000  0 -40000  0 0  50000 0  50000 -40000)
    )
    (via "Via[0-1]_600:300_um")
    (rule
      (width 2000)
      (clearance 200)
      (clearance 50 (type smd_smd))
    )
  )
  (placement
    (component ""
      (place R_DIV2 3000.000000 -32000.000000 front 0.000000 (PN 100k))
      (place R_DIV1 3000.000000 -30000.000000 front 0.000000 (PN 100k))
      (place R_PD 10000.000000 -14000.000000 front 0.000000 (PN 10k))
      (place R_LED 19000.000000 -4000.000000 front 0.000000 (PN 330R))
    )
    (component ::1
      (place FEM 40000.000000 -25000.000000 front 0.000000 (PN FEM))
    )
    (component ::2
      (place C2 7000.000000 -24000.000000 front 0.000000 (PN 10uF))
      (place C1 8000.000000 -22000.000000 front 0.000000 (PN 10uF))
    )
    (component ::3
      (place ANT2 46000.000000 -30000.000000 front 0.000000 (PN "U.FL-2400"))
      (place ANT1 46000.000000 -25000.000000 front 0.000000 (PN "U.FL-868"))
    )
    (component ::4
      (place SOLAR 3000.000000 -37000.000000 front 0.000000 (PN "Solar-Conn"))
    )
    (component ::5
      (place C_CAP 10000.000000 -37000.000000 front 0.000000 (PN Supercap))
    )
    (component ::6
      (place LED1 16000.000000 -4000.000000 front 0.000000 (PN "LED-0603"))
    )
    (component ::7
      (place D1 4000.000000 -18000.000000 front 0.000000 (PN BAT54))
    )
    (component ::8
      (place U4 5000.000000 -22000.000000 front 0.000000 (PN TPS7A02))
    )
    (component ::9
      (place U3 6000.000000 -33000.000000 front 0.000000 (PN "MAX-M10S"))
    )
    (component ::10
      (place U2 25000.000000 -25000.000000 front 0.000000 (PN LR2021F33))
    )
    (component ::11
      (place U1 12000.000000 -12000.000000 front 0.000000 (PN "ESP32-C3"))
    )
  )
  (library
    (image ""
      (pin Rect[T]Pad_600.000000x500.000000_um 2 500 0)
      (pin Rect[T]Pad_600.000000x500.000000_um 1 -500 0)
    )
    (image ::1
      (pin Rect[T]Pad_1000.000000x800.000000_um GND 1500 0)
      (pin Rect[T]Pad_1000.000000x800.000000_um VCC 0 0)
      (pin Rect[T]Pad_1000.000000x800.000000_um TX -1500 0)
    )
    (image ::2
      (pin Rect[T]Pad_700.000000x600.000000_um 2 500 0)
      (pin Rect[T]Pad_700.000000x600.000000_um 1 -500 0)
    )
    (image ::3
      (pin Rect[A]Pad_1000.000000x1000.000000_um 3 1500 0)
      (pin Rect[A]Pad_1000.000000x1000.000000_um 2 -1500 0)
      (pin Rect[T]Pad_1000.000000x1000.000000_um 1 0 0)
    )
    (image ::4
      (pin Rect[A]Pad_1600.000000x1600.000000_um 2 1270 0)
      (pin Rect[A]Pad_1600.000000x1600.000000_um 1 -1270 0)
    )
    (image ::5
      (pin Rect[A]Pad_1600.000000x1600.000000_um 2 2500 0)
      (pin Rect[A]Pad_1600.000000x1600.000000_um 1 -2500 0)
    )
    (image ::6
      (pin Rect[T]Pad_700.000000x600.000000_um K 500 0)
      (pin Rect[T]Pad_700.000000x600.000000_um A -500 0)
    )
    (image ::7
      (pin Rect[T]Pad_800.000000x600.000000_um K 1000 0)
      (pin Rect[T]Pad_800.000000x600.000000_um A -1000 0)
    )
    (image ::8
      (pin Rect[T]Pad_600.000000x400.000000_um 4 950 -750)
      (pin Rect[T]Pad_600.000000x400.000000_um 3 950 750)
      (pin Rect[T]Pad_600.000000x400.000000_um 2 0 750)
      (pin Rect[T]Pad_600.000000x400.000000_um 1 -950 750)
    )
    (image ::9
      (pin Rect[T]Pad_1000.000000x800.000000_um 3 700 0)
      (pin Rect[T]Pad_1000.000000x800.000000_um 2 -700 0)
      (pin Rect[T]Pad_1000.000000x800.000000_um 1 -2000 0)
    )
    (image ::10
      (pin Rect[T]Pad_1500.000000x800.000000_um 18 9900 -8000)
      (pin Rect[T]Pad_1200.000000x800.000000_um 17 9900 -6000)
      (pin Rect[T]Pad_1200.000000x800.000000_um 16 9900 -4000)
      (pin Rect[T]Pad_1200.000000x800.000000_um 14 9900 0)
      (pin Rect[T]Pad_1200.000000x800.000000_um 13 9900 2000)
      (pin Rect[T]Pad_1200.000000x800.000000_um 11 9900 6000)
      (pin Rect[T]Pad_1200.000000x800.000000_um 10 9900 8000)
      (pin Rect[T]Pad_1500.000000x800.000000_um 9 -9900 -8000)
      (pin Rect[T]Pad_1200.000000x800.000000_um 8 -9900 -6000)
      (pin Rect[T]Pad_1200.000000x800.000000_um 7 -9900 -4000)
      (pin Rect[T]Pad_1200.000000x800.000000_um 6 -9900 -2000)
      (pin Rect[T]Pad_1200.000000x800.000000_um 5 -9900 0)
      (pin Rect[T]Pad_1200.000000x800.000000_um 4 -9900 2000)
      (pin Rect[T]Pad_1200.000000x800.000000_um 3 -9900 4000)
      (pin Rect[T]Pad_1200.000000x800.000000_um 2 -9900 6000)
      (pin Rect[T]Pad_1200.000000x800.000000_um 1 -9900 8000)
    )
    (image ::11
      (pin Rect[T]Pad_1000.000000x600.000000_um GPIO19 3500 -750)
      (pin Rect[T]Pad_1000.000000x600.000000_um GND 3500 2250)
      (pin Rect[T]Pad_1000.000000x600.000000_um VCC 3500 3750)
      (pin Rect[T]Pad_1000.000000x600.000000_um GPIO10 3000 -3500)
      (pin Rect[T]Pad_1000.000000x600.000000_um GPIO9 1500 -3500)
      (pin Rect[T]Pad_1000.000000x600.000000_um GPIO7 -1500 -3500)
      (pin Rect[T]Pad_1000.000000x600.000000_um GPIO6 -3000 -3500)
      (pin Rect[T]Pad_1000.000000x600.000000_um GPIO5 -3500 -3750)
      (pin Rect[T]Pad_1000.000000x600.000000_um GPIO4 -3500 -2250)
      (pin Rect[T]Pad_1000.000000x600.000000_um GPIO3 -3500 -750)
      (pin Rect[T]Pad_1000.000000x600.000000_um GPIO2 -3500 750)
      (pin Rect[T]Pad_1000.000000x600.000000_um GPIO1 -3500 2250)
      (pin Rect[T]Pad_1000.000000x600.000000_um GPIO0 -3500 3750)
