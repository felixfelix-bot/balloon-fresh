      (attach off)
    )
    (padstack Rect[T]Pad_1000.000000x800.000000_um
      (shape (rect F.Cu -500 -400 500 400))
      (attach off)
    )
    (padstack Rect[T]Pad_1000.000000x1000.000000_um
      (shape (rect F.Cu -500 -500 500 500))
      (attach off)
    )
    (padstack Rect[A]Pad_1000.000000x1000.000000_um
      (shape (rect F.Cu -500 -500 500 500))
      (shape (rect B.Cu -500 -500 500 500))
      (attach off)
    )
    (padstack Rect[T]Pad_1200.000000x800.000000_um
      (shape (rect F.Cu -600 -400 600 400))
      (attach off)
    )
    (padstack Rect[T]Pad_1500.000000x800.000000_um
      (shape (rect F.Cu -750 -400 750 400))
      (attach off)
    )
    (padstack Rect[A]Pad_1600.000000x1600.000000_um
      (shape (rect F.Cu -800 -800 800 800))
      (shape (rect B.Cu -800 -800 800 800))
      (attach off)
    )
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net 3V3
      (pins R_DIV1-1 FEM-VCC C2-1 U4-4 U3-1 U2-1 U1-VCC)
    )
    (net GND
      (pins R_DIV2-2 FEM-GND C2-2 C1-2 ANT2-3 ANT2-2 ANT1-3 ANT1-2 SOLAR-2 C_CAP-2
        R_PD-1 LED1-K U4-2 U3-2 U2-17 U2-16 U2-11 U2-10 U2-8 U2-2 U1-GND)
    )
    (net SPI_SCK
      (pins U2-5 U1-GPIO6)
    )
    (net SPI_MOSI
      (pins U2-4 U1-GPIO7)
    )
    (net SPI_MISO
      (pins R_PD-2 U2-3 U1-GPIO2)
    )
    (net SPI_NSS
      (pins U2-6 U1-GPIO10)
    )
    (net LR2021_BUSY
      (pins U2-7 U1-GPIO4)
    )
    (net LR2021_RST
      (pins U2-14 U1-GPIO3)
    )
    (net LR2021_DIO9
      (pins U2-13 U1-GPIO5)
    )
    (net GPS_RX
      (pins U3-3 U1-GPIO1)
    )
    (net STATUS_LED
      (pins R_LED-1 U1-GPIO9)
    )
    (net LED_ANODE
      (pins R_LED-2 LED1-A)
    )
    (net VCAP
      (pins C1-1 C_CAP-1 D1-K U4-3 U4-1)
    )
    (net SOLAR_IN
      (pins SOLAR-1 D1-A)
    )
    (net FEM_TX
      (pins FEM-TX U1-GPIO19)
    )
    (net RF_SUB_868
      (pins ANT1-1 U2-9)
    )
    (net RF_2G4_2400
      (pins ANT2-1 U2-18)
    )
    (net VDIV_MID
      (pins R_DIV2-1 R_DIV1-2 U1-GPIO0)
    )
    (class kicad_default 3V3 FEM_TX GND GPS_RX LED_ANODE LR2021_BUSY LR2021_DIO9
      LR2021_RST RF_2G4_2400 RF_SUB_868 SOLAR_IN SPI_MISO SPI_MOSI SPI_NSS
      SPI_SCK STATUS_LED VCAP VDIV_MID
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 2000)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
