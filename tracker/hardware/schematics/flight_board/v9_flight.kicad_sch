		(uuid "2511eff7-2ba7-5991-9d3f-897fa11710c7")
	)	(text "TODO(unverified) OPEN-2 SX1280 SUPPLY (U4 pins 1,2) -- SX1280 VDD_IN/VDD_IO rail not fixed by any record and the Semtech datasheet is unreachable here. Left open deliberately."
		(exclude_from_sim no)
		(at 30.48 253.81 0)
		(effects
