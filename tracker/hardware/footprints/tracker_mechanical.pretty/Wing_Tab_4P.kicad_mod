(footprint "Tracker_Mechanical:Wing_Tab_4P"
  (version 20250114)
  (generator "balloon_v9_hand")
  (generator_version "9.0")
  (layer "F.Cu")
  (descr "Hub-side WING SOCKET land set for the v9 3D hub/wing assembly: FOUR wing interfaces, one per hub edge, at 90 deg spacing. Per interface: 4 copper lands on EACH outer face (F.Cu + B.Cu) = 8 lands per interface, land 4.0 x 1.2 mm, pitch 1.8 mm, pads 1..4 = SOLAR_P / GND / RF_FEED (v9 provision, NO NET) / SOLAR_N. Cited: docs/adr/046-wing-board-interface.md s2.1/s2.2/s4.1 (4-pin tab, land 4.0x1.2 mm, 1.8 mm pitch, insert depth 6.0 mm, hub slot 0.9 mm +/-0.10 mm, 90 deg attach) and docs/WING-TO-HUB-SOCKET-SPEC.md s2/s4/s6 (4 lands per face, 8 per interface, edge clearance, keep-outs, silkscreen). docs/adr/048-v9-hub-wing-interfaces.md records which numbers are cited vs newly decided. NOT human-accepted: ADR-046 and ADR-048 are Status Proposed.")
  (tags "balloon v9 hub wing socket 4P edge-socket Tracker_Mechanical")
  (attr smd)
  (property "Reference" "J_W" (at 8.0 -7.0 0) (layer "F.SilkS") (uuid "9f0a1b2c-0001-4000-8000-00000000a001") (effects (font (size 1 1) (thickness 0.15))))
  (property "Value" "Wing_Tab_4P" (at 8.0 7.0 0) (layer "F.Fab") (uuid "9f0a1b2c-0002-4000-8000-00000000a002") (effects (font (size 1 1) (thickness 0.15))))
  (property "Footprint" "" (at 0 0 0) (layer "F.Fab") (uuid "9f0a1b2c-0003-4000-8000-00000000a003") (effects (font (size 1 1) (thickness 0.15)) hide))

  # DATUM: the footprint ORIGIN is the intersection of the hub's INTERFACE (outer)
  # edge with the SLOT CENTRE LINE.  +x points INBOARD (into the hub), +y runs
  # ALONG the hub edge.  This datum is NEWLY DECIDED in ADR-048 (no in-repo
  # record fixes a hub-side datum); the land offsets below are cited.
  # TODO(unverified): hub v9 thickness / layer count (WING-TO-HUB-SOCKET-SPEC s8
  #   item 3) is not fixed by any in-repo source; the lands are on the two OUTER
  #   layers only.
  # TODO(unverified): the ASSEMBLY ORIENTATION.  WING-TO-HUB-SOCKET-SPEC s1 says
  #   the wing's long axis is "perpendicular to the hub plane" while the very next
  #   sentence ("Wings 1-2 horizontal, 3-4 inclined ~30 deg below the hub plane")
  #   and ADR-046 s4.1 ("wing plane normal to the hub plane") read the other way.
  #   No v9 hub PCB exists to place against, so no placement is asserted here.

  # 4 LANDS on the TOP face (F.Cu): WING-TO-HUB-SOCKET-SPEC s2 "8 lands per
  # interface (4 on the hub top face, 4 on the hub bottom face)".
  # Lands span x = 1.0 .. 5.0 mm from the interface edge: near edge 1.0 mm inboard
  # per ADR-046 s2.2 copper-to-board-edge clearance >= 1.0 mm (see ADR-048 D-1,
  # where the spec's >= 0.5 mm and its self-inconsistent land datum are recorded).
  (pad "1" smd rect (at 3.0 -2.7) (size 4.0 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (uuid "9f0a1b2c-0101-4000-8000-00000000b101"))
  (pad "2" smd rect (at 3.0 -0.9) (size 4.0 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (uuid "9f0a1b2c-0102-4000-8000-00000000b102"))
  (pad "3" smd rect (at 3.0 0.9) (size 4.0 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (uuid "9f0a1b2c-0103-4000-8000-00000000b103"))
  (pad "4" smd rect (at 3.0 2.7) (size 4.0 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (uuid "9f0a1b2c-0104-4000-8000-00000000b104"))

  # Pads 1..4 of the land row, viewed with +x inboard:
  #   1 = W<n>_SOLAR_P   (ADR-046 s2.1 pin 1; outermost - ADR-046 s2.1)
  #   2 = GND            (ADR-046 s2.1 pin 2)
  #   3 = W<n>_RF        (ADR-046 s2.1 pin 3, RF_FEED; NO NET on v9 - s2.4)
  #   4 = W<n>_SOLAR_N   (ADR-046 s2.1 pin 4; outermost)

  # the SAME 4 lands on the BOTTOM face (B.Cu): the tab is soldered from BOTH sides
  (pad "1" smd rect (at 3.0 -2.7) (size 4.0 1.2) (layers "B.Cu" "B.Paste" "B.Mask") (uuid "9f0a1b2c-0201-4000-8000-00000000c201"))
  (pad "2" smd rect (at 3.0 -0.9) (size 4.0 1.2) (layers "B.Cu" "B.Paste" "B.Mask") (uuid "9f0a1b2c-0202-4000-8000-00000000c202"))
  (pad "3" smd rect (at 3.0 0.9) (size 4.0 1.2) (layers "B.Cu" "B.Paste" "B.Mask") (uuid "9f0a1b2c-0203-4000-8000-00000000c203"))
  (pad "4" smd rect (at 3.0 2.7) (size 4.0 1.2) (layers "B.Cu" "B.Paste" "B.Mask") (uuid "9f0a1b2c-0204-4000-8000-00000000c204"))

  # ROUTED SLOT 0.9 mm x 6.0 mm - the wing tab's insertion key (ADR-046 s4.1,
  # WING-TO-HUB-SOCKET-SPEC s2.1 Option A).  On Edge.Cuts: it is a real board
  # cut-out, drawn as a CLOSED contour (a milled slot is a closed cut-out).
  # The contour runs on the insertion axis from the interface edge (x=0) 6.0 mm
  # inboard and must stop >= 5.0 mm short of the hub centre.
  # TODO(unverified): JLCPCB routed-slot width tolerance (0.9 mm +/-0.10 mm is an
  #   ASSUMPTION - ADR-046 s4.3 / spec s8 item 2) and the hub's actual component
  #   keep-out at the slot, which owns whether 6.0 mm depth is admissible
  #   (spec s8 item 1).
  (fp_line (start 0.0 -0.45) (end 6.0 -0.45) (stroke (width 0.05) (type solid)) (layer "Edge.Cuts") (uuid "9f0a1b2c-0301-4000-8000-00000000d301"))
  (fp_line (start 6.0 -0.45) (end 6.0 0.45) (stroke (width 0.05) (type solid)) (layer "Edge.Cuts") (uuid "9f0a1b2c-0302-4000-8000-00000000d302"))
  (fp_line (start 6.0 0.45) (end 0.0 0.45) (stroke (width 0.05) (type solid)) (layer "Edge.Cuts") (uuid "9f0a1b2c-0303-4000-8000-00000000d303"))
  (fp_line (start 0.0 0.45) (end 0.0 -0.45) (stroke (width 0.05) (type solid)) (layer "Edge.Cuts") (uuid "9f0a1b2c-0304-4000-8000-00000000d304"))

  # SLOT KEEP-OUT = slot outline + 1.0 mm on all sides (spec s4).  No copper other
  # than the four W<n>_* lands, no via, no courtyard and no silkscreen may enter it.
  # TODO(unverified): the hub's own routing/keep-out clearance rule may be larger
  #   than 1.0 mm; take the larger of the two (spec s4).
  (fp_line (start -1.0 -1.45) (end 7.0 -1.45) (stroke (width 0.05) (type dash)) (layer "Dwgs.User") (uuid "9f0a1b2c-0401-4000-8000-00000000e401"))
  (fp_line (start 7.0 -1.45) (end 7.0 1.45) (stroke (width 0.05) (type dash)) (layer "Dwgs.User") (uuid "9f0a1b2c-0402-4000-8000-00000000e402"))
  (fp_line (start 7.0 1.45) (end -1.0 1.45) (stroke (width 0.05) (type dash)) (layer "Dwgs.User") (uuid "9f0a1b2c-0403-4000-8000-00000000e403"))
  (fp_line (start -1.0 1.45) (end -1.0 -1.45) (stroke (width 0.05) (type dash)) (layer "Dwgs.User") (uuid "9f0a1b2c-0404-4000-8000-00000000e404"))

  # COURTYARD = the COMPONENT KEEP-OUT: no component body or courtyard within
  # 1.5 mm of the socket land row on either face (spec s4).  Land row bbox is
  # x 1.0..5.0, y -3.3..3.3; expanded 1.5 mm -> x -0.5..6.5, y -4.8..4.8.
  # TODO(unverified): the hub worker's placement gate may impose a larger value
  #   (spec s4); use the larger.
  (fp_line (start -0.5 -4.8) (end 6.5 -4.8) (stroke (width 0.05) (type solid)) (layer "F.CrtYd") (uuid "9f0a1b2c-0501-4000-8000-00000000f501"))
  (fp_line (start 6.5 -4.8) (end 6.5 4.8) (stroke (width 0.05) (type solid)) (layer "F.CrtYd") (uuid "9f0a1b2c-0502-4000-8000-00000000f502"))
  (fp_line (start 6.5 4.8) (end -0.5 4.8) (stroke (width 0.05) (type solid)) (layer "F.CrtYd") (uuid "9f0a1b2c-0503-4000-8000-00000000f503"))
  (fp_line (start -0.5 4.8) (end -0.5 -4.8) (stroke (width 0.05) (type solid)) (layer "F.CrtYd") (uuid "9f0a1b2c-0504-4000-8000-00000000f504"))

  # SILKSCREEN (spec s6): W<n> number, pin-1 marker, pin-4 marker, slot-axis
  # centre-line tick and the 90 deg orientation mark.  All clear of copper and of
  # the slot keep-out; text height 1.0 mm >= 0.8 mm, stroke 0.15 mm >= 0.12 mm.
  (fp_text user "W" (at 8.0 -6.4) (layer "F.SilkS") (uuid "9f0a1b2c-0601-4000-8000-000000010601") (effects (font (size 1.0 1.0) (thickness 0.15))))
  (fp_text user "1" (at 8.0 -2.7) (layer "F.SilkS") (uuid "9f0a1b2c-0602-4000-8000-000000010602") (effects (font (size 1.0 1.0) (thickness 0.15))))
  (fp_text user "4" (at 8.0 2.7) (layer "F.SilkS") (uuid "9f0a1b2c-0603-4000-8000-000000010603") (effects (font (size 1.0 1.0) (thickness 0.15))))
  (fp_text user "90" (at 8.0 5.2) (layer "F.SilkS") (uuid "9f0a1b2c-0604-4000-8000-000000010604") (effects (font (size 1.0 1.0) (thickness 0.15))))
  (fp_line (start 6.4 0.0) (end 7.6 0.0) (stroke (width 0.15) (type solid)) (layer "F.SilkS") (uuid "9f0a1b2c-0605-4000-8000-000000010605"))
)
