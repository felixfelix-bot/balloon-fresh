      (libsource (lib "balloon_flight_v10") (part "F33_VCC_SEL") (description "ADR-029 D8 pin-1 rail selector (operator-RATIFIED 2026-10-05), restored to v10 by ADR-129 D1: a 3-pad solder jumper. pin 2 COMMON -> /F33_VCC; pin 1 -> /VSCAP (raw supercap node, PRE-LDO) to fly the F33 2 W PA; pin 3 -> +3V3 (TPS7A02 OUT) to fly the nested bare LoRa2021. All pins passive: a solder jumper is a hand-made connection, not a driven port."))
      (property (name "Sheetname") (value ""))
      (property (name "Sheetfile") (value "v10_flight.kicad_sch"))
